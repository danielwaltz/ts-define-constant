{
  "name": "ts-define-constant",
  "type": "module",
  "version": "2.0.0",
  "description": "Type safe utility for defining static constants with automatic type narrowing and additional helper functions",
  "author": "Daniel Waltz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielwaltz/ts-define-constant.git"
  },
  "keywords": [
    "utility",
    "typescript",
    "constant",
    "narrowing",
    "type-narrowing"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "obuild",
    "stub": "obuild --stub",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/.eslintcache --max-warnings 0",
    "publint": "npx -y publint@latest && npx -y @arethetypeswrong/cli@latest --pack --profile esm-only",
    "type-check": "tsc --noEmit",
    "test:unit": "vitest",
    "test:unit:run": "vitest run",
    "test:type-check:run": "vitest run --typecheck.only",
    "test": "run-s lint type-check build test:unit:run test:type-check:run publint",
    "release": "standard-version",
    "semantic-release": "semantic-release",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@danielwaltz/eslint-config": "^3.3.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/node": "~24.10.15",
    "eslint": "^10.0.3",
    "npm-run-all2": "^8.0.4",
    "obuild": "^0.4.31",
    "prettier": "^3.8.1",
    "semantic-release": "^25.0.3",
    "standard-version": "^9.5.0",
    "type-fest": "^5.4.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "conventional-changelog-conventionalcommits": ">=9.3.0"
  }
}
