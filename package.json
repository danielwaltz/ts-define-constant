{
  "name": "ts-define-constant",
  "version": "2.0.0",
  "description": "Type safe utility for defining static constants with automatic type narrowing and additional helper functions",
  "type": "module",
  "keywords": [
    "utility",
    "typescript",
    "constant",
    "narrowing",
    "type-narrowing"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielwaltz/ts-define-constant.git"
  },
  "author": "Daniel Waltz",
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "unbuild",
    "stub": "unbuild --stub",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/.eslintcache --max-warnings 0",
    "publint": "npx -y publint@latest && npx -y @arethetypeswrong/cli@latest --pack --profile esm-only",
    "type-check": "tsc --noEmit",
    "test:unit": "vitest",
    "test:unit:run": "vitest run",
    "test:type-check:run": "vitest run --typecheck.only",
    "test": "run-s lint type-check build test:unit:run test:type-check:run publint",
    "release": "standard-version",
    "semantic-release": "semantic-release",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@danielwaltz/eslint-config": "^2.5.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.3",
    "@semantic-release/npm": "^12.0.2",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "@types/node": "~22.17.0",
    "eslint": "^9.32.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.6.2",
    "semantic-release": "^24.2.7",
    "standard-version": "^9.5.0",
    "type-fest": "^4.41.0",
    "typescript": "^5.9.2",
    "unbuild": "^3.6.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "conventional-changelog-conventionalcommits": ">=9.1.0"
  }
}
